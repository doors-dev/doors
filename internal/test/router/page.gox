elem static(path string, code int) {
	<html>
		<head></head>
		~(if code >= 0 {
			~(doors.Status(code))
		})
		<body>
			<div id="path">~(path)</div>
		</body>
	</html>
}

type PathC struct {
	PathC1 bool `path:"/c1"`
	PathC2 bool `path:"/c2"`
}

elem pageC(b doors.Source[PathC]) {
	<html>
		<body>
			~(b.Bind(elem(path PathC) {
				~(if path.PathC1 {
					<div id="path">c1</div>
				} else {
					<div id="path">c2</div>
				})
			}))
			
			~>doors.ALink{
				Model: PathC{
					PathC1: true,
				},
			} <a>c1</a>
			
			~>doors.ALink{
				Model: PathC{
					PathC2: true,
				},
			} <a id="c2">c2</a>
			
			~>doors.AClick{
				On: func(ctx context.Context, r doors.RequestEvent[doors.PointerEvent]) bool {
					doors.Call(ctx, doors.ActionLocationReplace{Model: PathC{PathC2: true}})
					return true
				},
			} <button id="replace">replace</button>
			<div id="marker">~(doors.IDRand())</div>
			
			~>doors.AClick{
				On: func(ctx context.Context, r doors.RequestEvent[doors.PointerEvent]) bool {
					doors.Call(ctx, doors.ActionLocationReload{})
					return false
				},
			} <button id="reload">reload</button>
			
			~>doors.AClick{
				On: func(ctx context.Context, r doors.RequestEvent[doors.PointerEvent]) bool {
					r.After(doors.ActionLocationAssign{Model: PathB{}})
					return false
				},
			} <button id="assign_after">assign_after</button>
			
			~>doors.AClick{
				On: func(ctx context.Context, r doors.RequestEvent[doors.PointerEvent]) bool {
					r.After(doors.ActionLocationReplace{Model: PathB{}})
					return false
				},
			} <button id="replace_after">replace_after</button>
			
			~>doors.AClick{
				On: func(ctx context.Context, r doors.RequestEvent[doors.PointerEvent]) bool {
					r.After(doors.ActionLocationReload{})
					return false
				},
			} <button id="reload_after">reload_after</button>
		</body>
	</html>
}

