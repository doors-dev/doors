package test

import (
	"github.com/doors-dev/doors"
	"github.com/doors-dev/gox"
)

type NoBeam struct{}

type PathLens = doors.Source[Path]

func (f NoBeam) setBeam(_ PathLens) {}

type Beam struct {
	B PathLens
}

func (f *Beam) setBeam(b PathLens) {
	f.B = b
}

type Path struct {
	Vh bool `path:""`
	Vs bool `path:"/s"`
	Vp bool `path:"/s/:P"`
	P string
}

type Fragment interface {
	setBeam(b PathLens)
	gox.Comp
}

type Page struct {
	Source PathLens
	F Fragment
	H elem(PathLens)
	Header string
}

func (p *Page) h1() string {
	return p.Header
}

func (p *Page) head() gox.Elem {
	if p.H == nil {
		return nil
	}
	return p.H(p.Source)
}

elem (p *Page) content() {
	~(if p.F != nil {
		~~
		p.F.setBeam(p.Source)
		~~
		~(p.F)
	})
}

elem (p *Page) Main() {
	~(Document(p))
}
