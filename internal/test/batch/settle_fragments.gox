package batch

import (
	"context"
	"fmt"
	"strings"

	"github.com/doors-dev/doors"
	"github.com/doors-dev/doors/internal/test"
	"github.com/doors-dev/gox"
)

type settleRead struct {
	value string
	values []error
}

type settleOp struct {
	values []error
}

type settleFragment struct {
	test.NoBeam
	g *gate
	fired chan struct{}
	returned chan struct{}
	ops chan settleOp
	seen chan settleRead
	x doors.Door
	y doors.Door
	o doors.Door
	d doors.Door
	res doors.Door
	s doors.Setter
}

func newSettleFragment() *settleFragment {
	return &settleFragment{
		g: newGate(),
		fired: make(chan struct{}, 8),
		returned: make(chan struct{}, 8),
		ops: make(chan settleOp, 1),
		seen: make(chan settleRead, 8),
	}
}

func (f *settleFragment) settleHold(ctx context.Context) {
	f.g.entered <- struct{}{}
	select {
	case <-f.g.proceed:
	case <-ctx.Done():
	}
}

func (f *settleFragment) settleEmit(ctx context.Context, name string, arg any) (*string, <-chan error) {
	v := new(string)
	return v, doors.Call(ctx, doors.ActionEmit[string]{Name: name, Arg: arg}.Into(v))
}

func (f *settleFragment) settleRead(ctx context.Context, name string, arg any) settleRead {
	v, ch := f.settleEmit(ctx, name, arg)
	values := drain(ch)
	return settleRead{value: *v, values: values}
}

func (f *settleFragment) settleSummary(op settleOp) string {
	parts := make([]string, len(op.values))
	for i, err := range op.values {
		parts[i] = fmt.Sprint(err)
	}
	return fmt.Sprintf("%d:%s", len(op.values), strings.Join(parts, ","))
}

func (f *settleFragment) settleMark(ctx context.Context) {
	f.fired <- struct{}{}
}

elem (f *settleFragment) settleDelivered() {
	~>(&f.s) <div id="settle-item">delivered</div>
}

elem (f *settleFragment) settleBatched(id string, on func(ctx context.Context)) {
	~>doors.AClick{
		Batch: true,
		Indicator: doors.IndicateAttrQuery("#ind-a", "data-busy", "true"),
		On: func(ctx context.Context, _ doors.RequestEvent[doors.PointerEvent]) bool {
			on(ctx)
			f.returned <- struct{}{}
			return false
		},
	} <button id=(id)>~(id)</button>
}

elem (f *settleFragment) Main() {
	<div id="ind-a">ind-a</div>
	~>(f.x) <div id="x">x0</div>
	~>(f.y) <div id="y">y0</div>
	~>(f.o) <div id="o">o0</div>
	~>(f.d) <div id="d">d0</div>
	~>(f.res) <div id="settle-res">none</div>
	<div id="settle-seen">none</div>
	<script>
		const text = (selector) =>
			document.querySelector(selector)?.textContent ?? "missing"
		$on("settle_text", (selector) => text(selector))
		$on("settle_read", () => {
			const value = text("#x") + "|" + text("#y")
			document.getElementById("settle-seen").textContent = value
			return value
		})
		$on("settle_attr", (selector) =>
			document.querySelector(selector)?.getAttribute("data-settle") ?? "missing")
		document.documentElement.setAttribute("data-settle-ready", "")
	</script>
	~(f.settleBatched("settle-op", func(ctx context.Context) {
		<-f.x.Inner(ctx, "x1")
		doors.OnSettle(ctx, func(sctx context.Context) {
			f.settleMark(sctx)
			ch := f.o.Inner(sctx, "o1")
			go func() {
				var op settleOp
				op.values = drain(ch)
				f.res.Inner(sctx, <div id="settle-res">~(f.settleSummary(op))</div>)
				f.ops <- op
			}()
		})
		f.settleHold(ctx)
		f.y.Inner(ctx, "y1")
	}))
	~(f.settleBatched("settle-call", func(ctx context.Context) {
		<-f.x.Inner(ctx, "x1")
		doors.OnSettle(ctx, func(sctx context.Context) {
			f.settleMark(sctx)
			go func() {
				f.seen <- f.settleRead(sctx, "settle_read", nil)
			}()
		})
		f.settleHold(ctx)
		f.y.Inner(ctx, "y1")
	}))
	~(f.settleBatched("settle-sync", func(ctx context.Context) {
		<-f.d.Inner(ctx, f.settleDelivered())
		doors.OnSettle(ctx, func(sctx context.Context) {
			f.settleMark(sctx)
			set := doors.Call(sctx, f.s.Set("data-settle", "set"))
			v, ch := f.settleEmit(sctx, "settle_attr", "#settle-item")
			go func() {
				values := append(drain(set), drain(ch)...)
				f.seen <- settleRead{value: *v, values: values}
			}()
		})
		f.settleHold(ctx)
	}))
	~(f.settleBatched("settle-hold", func(ctx context.Context) {
		doors.OnSettle(ctx, f.settleMark)
		release := doors.HoldSettle(ctx)
		go func() {
			defer release()
			<-f.x.Inner(ctx, "x-hold")
			f.settleHold(ctx)
			f.y.Inner(ctx, "y-hold")
		}()
	}))
	~(f.settleBatched("settle-idle", func(ctx context.Context) {
		doors.OnSettle(ctx, f.settleMark)
		<-f.x.Inner(ctx, "x-idle")
		release := doors.HoldSettle(ctx)
		go func() {
			defer release()
			f.settleHold(ctx)
		}()
	}))
	~(test.Button("settle-after", func(ctx context.Context) bool {
		f.x.Inner(ctx, "x-after")
		f.y.Inner(ctx, "y-after")
		return false
	}))
}

var _ gox.Comp = (*settleFragment)(nil)
