package batch

import (
	"github.com/doors-dev/doors"
	"github.com/doors-dev/doors/internal/test"
	"github.com/doors-dev/gox"
)

type linkFragment struct {
	test.Beam
	g *gate
}

elem (f *linkFragment) slow(v test.Path) {
	~~
	if v.P != "" {
		f.g.entered <- struct{}{}
		select {
		case <-f.g.proceed:
		case <-ctx.Done():
		}
	}
	~~
	<span id="slow">~("slow-" + v.P)</span>
}

elem (f *linkFragment) Main() {
	~(f.B.Bind(elem(v test.Path) {
		<span id="fast">~("fast-" + v.P)</span>
	}))
	~(f.B.Bind(elem(v test.Path) {
		~(f.slow(v))
	}))
	~>doors.ALink{
		Model: test.Path{Vp: true, P: "batched"},
		Batch: true,
	} <a id="link-batched">batched</a>
	~>doors.ALink{
		Model: test.Path{Vp: true, P: "plain"},
	} <a id="link-plain">plain</a>
}

var _ gox.Comp = (*linkFragment)(nil)
