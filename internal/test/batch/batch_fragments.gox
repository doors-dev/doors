package batch

import (
	"context"

	"github.com/doors-dev/doors"
	"github.com/doors-dev/doors/internal/test"
	"github.com/doors-dev/gox"
)

type gate struct {
	entered chan struct{}
	proceed chan struct{}
}

func newGate() *gate {
	return &gate{
		entered: make(chan struct{}, 1),
		proceed: make(chan struct{}),
	}
}

type batchFragment struct {
	test.NoBeam
	r *test.Reporter
	g *gate
	a doors.Door
	b doors.Door
	c doors.Door
}

func (f *batchFragment) split(ctx context.Context, first string, second string) bool {
	f.a.Inner(ctx, first)
	f.g.entered <- struct{}{}
	select {
	case <-f.g.proceed:
	case <-ctx.Done():
	}
	f.b.Inner(ctx, second)
	return false
}

elem (f *batchFragment) Main() {
	~(f.r)
	~>(f.a) <div id="a">a0</div>
	~>(f.b) <div id="b">b0</div>
	~>(f.c) <div id="c">c0</div>
	~>doors.AClick{
		Batch: true,
		On: func(ctx context.Context, _ doors.RequestEvent[doors.PointerEvent]) bool {
			return f.split(ctx, "a1", "b1")
		},
	} <button id="batched">batched</button>
	~(test.Button("plain", func(ctx context.Context) bool {
		return f.split(ctx, "a2", "b2")
	}))
	~(test.Button("other", func(ctx context.Context) bool {
		f.c.Inner(ctx, "c1")
		return false
	}))
	~(test.Button("same", func(ctx context.Context) bool {
		f.a.Inner(ctx, "a-late")
		return false
	}))
	~(test.Button("onbatch", func(ctx context.Context) bool {
		doors.OnBatch(ctx, func(ctx context.Context) {
			f.r.Update(ctx, 0, "applied")
		}, func(ctx context.Context) {
			f.a.Inner(ctx, "a3")
			f.b.Inner(ctx, "b3")
		})
		return false
	}))
}

var _ gox.Comp = (*batchFragment)(nil)
