package batch

import (
	"context"

	"github.com/doors-dev/doors"
	"github.com/doors-dev/doors/internal/test"
	"github.com/doors-dev/gox"
)

type titleFragment struct {
	test.NoBeam
	g *gate
	a doors.Door
	b doors.Door
}

elem titleContent(title string, text string) {
	<title>~(title)</title>
	<span>~(text)</span>
}

func (f *titleFragment) retitle(ctx context.Context) bool {
	f.a.Inner(ctx, titleContent("second", "a1"))
	f.g.entered <- struct{}{}
	select {
	case <-f.g.proceed:
	case <-ctx.Done():
	}
	f.b.Inner(ctx, "b1")
	return false
}

elem (f *titleFragment) Main() {
	~>(f.a) <div id="a">~(titleContent("first", "a0"))</div>
	~>(f.b) <div id="b">b0</div>
	~>doors.AClick{
		Batch: true,
		On: func(ctx context.Context, _ doors.RequestEvent[doors.PointerEvent]) bool {
			return f.retitle(ctx)
		},
	} <button id="title-batched">title-batched</button>
}
