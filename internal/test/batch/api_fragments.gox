package batch

import (
	"context"
	
	"github.com/doors-dev/doors"
	"github.com/doors-dev/doors/internal/test"
	"github.com/doors-dev/gox"
)

type apiRead struct {
	value string
	err error
	ok bool
}

type apiGuard struct {
	call []error
	value string
	plain []error
	inner []error
}

type apiFragment struct {
	test.NoBeam
	g *gate
	start chan struct{}
	fired chan struct{}
	seen chan apiRead
	guard chan apiGuard
	a doors.Door
	b doors.Door
	d doors.Door
	s doors.Setter
}

func newAPIFragment() *apiFragment {
	return &apiFragment{
		g: newGate(),
		start: make(chan struct{}),
		fired: make(chan struct{}, 8),
		seen: make(chan apiRead, 8),
		guard: make(chan apiGuard, 1),
	}
}

func (f *apiFragment) apiHold(ctx context.Context) {
	f.g.entered <- struct{}{}
	select {
	case <-f.g.proceed:
	case <-ctx.Done():
	}
}

func callResult(ch <-chan error) (error, bool) {
	err, ok := <-ch
	if !ok || err != nil {
		return err, ok
	}
	err, ok = <-ch
	return err, ok
}

func drain(ch <-chan error) []error {
	var got []error
	for err := range ch {
		got = append(got, err)
	}
	return got
}

func (f *apiFragment) apiRead(ctx context.Context) apiRead {
	var v string
	err, ok := callResult(doors.Call(ctx, doors.ActionEmit[string]{Name: "api_read"}.Into(&v)))
	return apiRead{value: v, err: err, ok: ok}
}

func (f *apiFragment) apiGuard(ctx context.Context) {
	var v string
	res := apiGuard{call: drain(doors.Call(ctx, doors.ActionEmit[string]{Name: "api_read"}.Into(&v)))}
	res.value = v
	res.plain = drain(doors.Call(ctx, doors.ActionScroll{Selector: "#a"}))
	res.inner = drain(f.a.Inner(ctx, "a1"))
	f.guard <- res
	f.b.Inner(ctx, "b1")
}

func (f *apiFragment) apiOn(ctx context.Context) {
	f.fired <- struct{}{}
	go func() {
		f.seen <- f.apiRead(ctx)
	}()
}

elem (f *apiFragment) apiDelivered() {
	~>(&f.s) <div id="api-item">delivered</div>
}

elem (f *apiFragment) apiBatched(id string, on func(ctx context.Context)) {
	~>doors.AClick{
		Batch: true,
		On: func(ctx context.Context, _ doors.RequestEvent[doors.PointerEvent]) bool {
			on(ctx)
			return false
		},
	} <button id=(id)>~(id)</button>
}

elem (f *apiFragment) Main() {
	~>(f.a) <div id="a">a0</div>
	~>(f.b) <div id="b">b0</div>
	~>(f.d) <div id="d">d0</div>
	<div id="api-seen">none</div>
	<script>
		const text = (selector) =>
			document.querySelector(selector)?.textContent ?? "missing"
		$on("api_read", () => text("#a") + "|" + text("#b"))
		$on("api_mark", (selector) => {
			document.getElementById("api-seen").textContent = text(selector)
		})
		document.documentElement.setAttribute("data-api-ready", "")
	</script>
	~(doors.Go(func(ctx context.Context) {
		select {
		case <-f.start:
		case <-ctx.Done():
			return
		}
		doors.OnBatch(doors.DetachedContext(ctx), f.apiOn, func(ctx context.Context) {
			f.a.Inner(ctx, "a1")
		}, func(ctx context.Context) {
			f.apiHold(ctx)
			f.b.Inner(ctx, "b1")
		})
	}))
	~(test.Button("api-plain", func(ctx context.Context) bool {
		doors.OnBatch(ctx, f.apiOn, func(ctx context.Context) {
			f.a.Inner(ctx, "a1")
		}, func(ctx context.Context) {
			f.apiHold(ctx)
			f.b.Inner(ctx, "b1")
		})
		return false
	}))
	~(f.apiBatched("api-join", func(ctx context.Context) {
		doors.OnBatch(ctx, f.apiOn, func(ctx context.Context) {
			f.a.Inner(ctx, "a1")
		})
		f.apiHold(ctx)
		f.b.Inner(ctx, "b1")
	}))
	~(f.apiBatched("api-settle", func(ctx context.Context) {
		f.d.Inner(ctx, f.apiDelivered())
		doors.OnSettle(ctx, func(ctx context.Context) {
			doors.Call(ctx, f.s.Set("data-api", "set"))
			doors.Call(ctx, doors.ActionEmit[any]{Name: "api_mark", Arg: "#api-item"})
		})
		f.apiHold(ctx)
	}))
	~(f.apiBatched("api-guard", f.apiGuard))
	~(test.Button("api-guard-plain", func(ctx context.Context) bool {
		f.apiGuard(ctx)
		return false
	}))
	~(f.apiBatched("api-detached", func(ctx context.Context) {
		f.a.Inner(ctx, "a1")
		f.seen <- f.apiRead(doors.DetachedContext(ctx))
		f.apiHold(ctx)
		f.b.Inner(ctx, "b1")
	}))
	~(f.apiBatched("api-held", func(ctx context.Context) {
		doors.Call(ctx, doors.ActionScroll{Selector: "#a"})
		var v string
		ch := doors.Call(doors.DetachedContext(ctx), doors.ActionEmit[string]{Name: "api_read"}.Into(&v))
		go func() {
			err, ok := callResult(ch)
			f.seen <- apiRead{value: v, err: err, ok: ok}
		}()
		f.apiHold(ctx)
		f.a.Inner(ctx, "a1")
		f.b.Inner(ctx, "b1")
	}))
}

var _ gox.Comp = (*apiFragment)(nil)
