package batch

import (
	"context"

	"github.com/doors-dev/doors"
	"github.com/doors-dev/doors/internal/test"
	"github.com/doors-dev/gox"
)

type groupFragment struct {
	test.NoBeam
	g *gate
	fired chan struct{}
	x doors.Door
	y doors.Door
}

func newGroupFragment() *groupFragment {
	return &groupFragment{
		g: newGate(),
		fired: make(chan struct{}, 8),
	}
}

func (f *groupFragment) groupHold(ctx context.Context) {
	f.g.entered <- struct{}{}
	select {
	case <-f.g.proceed:
	case <-ctx.Done():
	}
}

func (f *groupFragment) groupOn(ctx context.Context) {
	f.fired <- struct{}{}
}

elem (f *groupFragment) groupSlow(text string) {
	~{
		f.groupHold(ctx)
	}
	~(text)
}

elem (f *groupFragment) Main() {
	<div id="ind">ind</div>
	~>(f.x) <div id="x">x0</div>
	~>(f.y) <div id="y">y0</div>
	~>doors.AClick{
		Batch: true,
		On: func(ctx context.Context, _ doors.RequestEvent[doors.PointerEvent]) bool {
			<-f.x.Inner(ctx, "x-held")
			f.groupHold(ctx)
			return false
		},
	} <button id="group-holder">group-holder</button>
	~>doors.AClick{
		Indicator: doors.IndicateAttrQuery("#ind", "data-busy", "true"),
		On: func(ctx context.Context, _ doors.RequestEvent[doors.PointerEvent]) bool {
			doors.OnBatch(ctx, f.groupOn, func(ctx context.Context) {
				f.x.Inner(ctx, "x-plain")
				f.y.Inner(ctx, "y-plain")
			})
			return false
		},
	} <button id="group-plain">group-plain</button>
	~>doors.AClick{
		Batch: true,
		On: func(ctx context.Context, _ doors.RequestEvent[doors.PointerEvent]) bool {
			doors.OnSettle(ctx, func(ctx context.Context) {
				doors.OnBatch(ctx, f.groupOn, func(ctx context.Context) {
					f.x.Inner(ctx, "x-settle")
					f.y.Inner(ctx, f.groupSlow("y-settle"))
				})
			})
			return false
		},
	} <button id="group-settle">group-settle</button>
}

var _ gox.Comp = (*groupFragment)(nil)
