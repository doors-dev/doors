package attr

import (
	"context"
	"fmt"
	"sync/atomic"
	"time"
	
	"github.com/doors-dev/doors"
	"github.com/doors-dev/doors/internal/test"
	"github.com/doors-dev/gox"
)

type scopeFragment struct {
	r *test.Reporter
	test.NoBeam
	counter atomic.Int32
}

func (f *scopeFragment) update(ctx context.Context, marker string) {
	i := f.counter.Add(1)
	f.r.Update(ctx, 0, fmt.Sprint(i - 1))
	f.r.Update(ctx, 1, marker)
}

elem (f *scopeFragment) scopePipeline() {
	~~
	ds := &doors.ScopeDebounce{Duration: 250 * time.Millisecond, Limit: 0}
	ds2 := &doors.ScopeDebounce{Duration: 250 * time.Millisecond, Limit: 0}
	ss := &doors.ScopeSerial{}
	fs := &doors.ScopeFrame{}
	~~
	~(f.button("p1", ds, "1", false))
	~(f.button("p2", fs.Scope(false).And(ds).And(ss), "2", true))
	~(f.button("p3", fs.Scope(false).And(ds2).And(ss), "3", true))
	~(f.button("p4", fs.Scope(false).And(ds2).And(ss), "4", false))
	~(f.button("p5", fs.Scope(true), "5", true))
}

elem (f *scopeFragment) Main() {
	~~
	f.update(ctx, "0")
	~~
	~(f.r)
	~~
	blocking := &doors.ScopeBlocking{}
	~~
	~(f.button("b1", blocking, "1", true))
	~(f.button("b2", blocking, "2", true))
	~(f.button("b3", blocking, "3", true)) ~// serial
	~~
	serial := &doors.ScopeSerial{}
	~~
	~(f.button("s1", serial, "1", true))
	~(f.button("s2", serial, "2", true))
	~(f.button("s3", serial, "3", true)) ~// debounce
	~~
	debouce := &doors.ScopeDebounce{Duration: 300 * time.Millisecond, Limit: 0}
	~~
	~(f.button("d1", debouce, "1", false))
	~(f.button("d2", debouce, "2", false))
	~(f.button("d3", debouce, "3", false)) ~// debounce with limit
	~~
	debouce = &doors.ScopeDebounce{Duration: 300 * time.Millisecond, Limit: 700 * time.Millisecond}
	~~
	~(f.button("dl1", debouce, "1", false))
	~(f.button("dl2", debouce, "2", false))
	~(f.button("dl3", debouce, "3", false)) ~// frame
	~~
	frame := &doors.ScopeFrame{}
	~~
	~(f.button("f1", frame.Scope(false), "1", true))
	~(f.button("f2", frame.Scope(false), "2", false))
	~(f.button("f3", frame.Scope(true), "3", true))
	~(f.button("f4", frame.Scope(true), "4", false))
	~// latest
	~~
	latest := &doors.ScopeLatest{}
	~~
	~(f.buttonLatest("l1", latest, "1"))
	~(f.buttonLatest("l2", latest, "2"))
	~(f.buttonLatest("l3", latest, "3"))
	~// concurrent
	~~
	concurrent := &doors.ScopeConcurrent{}
	~~
	~(f.button("c1", concurrent.Scope(1), "1", true))
	~(f.button("c2", concurrent.Scope(1), "2", true))
	~(f.button("c3", concurrent.Scope(2), "3", false))
	~// rate
	~~
	rate := &doors.ScopeRate{Tick: 300 * time.Millisecond}
	~~
	~(f.button("r1", rate, "1", false))
	~(f.button("r2", rate, "2", false))
	~(f.button("r3", rate, "3", false))
	~(f.scopePipeline())
}

elem (f *scopeFragment) button(id string, scope doors.Scopes, marker string, delay bool) {
	<button id=(id) (doors.A(ctx, f.handler(scope, marker, delay)))>~(id)</button>
}

elem (f *scopeFragment) buttonLatest(id string, scope doors.Scopes, marker string) {
	<button id=(id) (doors.A(ctx, f.handlerLatest(scope, marker)))>~(id)</button>
}

func (f *scopeFragment) handler(scope doors.Scopes, marker string, delay bool) doors.Attr {
	return doors.AClick{
		Scope: scope,
		On: func(ctx context.Context, r doors.RequestEvent[doors.PointerEvent]) bool {
			if delay {
				<-time.After(300 * time.Millisecond)
			}
			f.update(ctx, marker)
			return false
		},
	}
}

func (f *scopeFragment) handlerLatest(scope doors.Scopes, marker string) doors.Attr {
	return doors.AClick{
		Scope: scope,
		On: func(ctx context.Context, r doors.RequestEvent[doors.PointerEvent]) bool {
			select {
			case <-time.After(300 * time.Millisecond):
			case <-ctx.Done():
				return false
			}
			f.update(ctx, marker)
			return false
		},
	}
}
