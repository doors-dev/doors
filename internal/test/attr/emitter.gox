elem (f *emitterFocusFragment) Main() {
	~~
	f.r.Update(ctx, 0, "")
	f.r.Update(ctx, 1, "")
	~~
	~(f.r)
	<div (doors.A(ctx, f.outer()...))>
		<input type="text" id="target" (&f.e) (doors.A(ctx, f.inner()...))/>
	</div>
	~(test.Button("emit-focus", func(ctx context.Context) bool {
		doors.Call(ctx, f.e.Focus(doors.FocusEmit{}))
		return false
	}))
	~(test.Button("emit-blur", func(ctx context.Context) bool {
		doors.Call(ctx, f.e.Blur(doors.FocusEmit{}))
		return false
	}))
	~(test.Button("emit-focusin", func(ctx context.Context) bool {
		doors.Call(ctx, f.e.FocusIn(doors.FocusEmit{}))
		return false
	}))
	~(test.Button("emit-focusout", func(ctx context.Context) bool {
		doors.Call(ctx, f.e.FocusOut(doors.FocusEmit{}))
		return false
	}))
}

// input, change, submit

type emitterFormFragment struct {
	test.NoBeam
	r *test.Reporter
	ei doors.Emitter
	es doors.Emitter
}

func (f *emitterFormFragment) fieldAttrs() []doors.Attr {
	return []doors.Attr{
		doors.AInput{
			On: func(ctx context.Context, r doors.RequestEvent[doors.InputEvent]) bool {
				f.r.Update(ctx, 0, "input")
				f.r.Update(ctx, 1, r.Event().Data)
				return false
			},
		},
		doors.AChange{
			On: func(ctx context.Context, r doors.RequestEvent[doors.ChangeEvent]) bool {
				f.r.Update(ctx, 2, "change")
				f.r.Update(ctx, 3, r.Event().Name)
				return false
			},
		},
	}
}

func (f *emitterFormFragment) submit() doors.Attr {
	return doors.ASubmit[struct{}]{
		On: func(ctx context.Context, r doors.RequestForm[struct{}]) bool {
			f.r.Update(ctx, 4, "submit")
			return false
		},
	}
}

elem (f *emitterFormFragment) Main() {
	~~
	for i := 0; i < 5; i++ {
		f.r.Update(ctx, i, "")
	}
	~~
	~(f.r)
	<input type="text" id="field" name="field" (&f.ei) (doors.A(ctx, f.fieldAttrs()...))/>
	~>(f.submit()) <form id="form" (&f.es)>
		<input type="text" name="field"/>
	</form>
	~(test.Button("emit-input", func(ctx context.Context) bool {
		doors.Call(ctx, f.ei.Input(doors.InputEmit{Data: "hey"}))
		return false
	}))
	~(test.Button("emit-change", func(ctx context.Context) bool {
		doors.Call(ctx, f.ei.Change(doors.ChangeEmit{}))
		return false
	}))
	~(test.Button("emit-submit", func(ctx context.Context) bool {
		doors.Call(ctx, f.es.Submit(doors.SubmitEmit{}))
		return false
	}))
}

// multiple elements + capture report

func emitterCall[T any](action doors.ActionInto[T], then func(ctx context.Context, v T, err error)) func(context.Context) bool {
	return func(ctx context.Context) bool {
		var v T
		ch := doors.Call(doors.DetachedContext(ctx), action.Into(&v))
		<-ch
		select {
		case err := <-ch:
			then(ctx, v, err)
		case <-ctx.Done():
		}
		return false
	}
}

func emitReportString(report doors.EmitReport, err error) string {
	if err != nil {
		return err.Error()
	}
	return fmt.Sprintf("ok:%d canceled:%d failed:%v", report.OK, report.Canceled, report.Failed)
}

func emitterReport(r *test.Reporter, slot int, action doors.ActionInto[doors.EmitReport]) func(context.Context) bool {
	return emitterCall(action, func(ctx context.Context, report doors.EmitReport, err error) {
		r.Update(ctx, slot, emitReportString(report, err))
	})
}

func emitterCount(r *test.Reporter, slot int, action doors.ActionInto[int]) func(context.Context) bool {
	return emitterCall(action, func(ctx context.Context, count int, err error) {
		if err != nil {
			r.Update(ctx, slot, "err")
			return
		}
		r.Update(ctx, slot, fmt.Sprint(count))
	})
}

type emitterMultiFragment struct {
	test.NoBeam
	r *test.Reporter
	e doors.Emitter
}

func (f *emitterMultiFragment) hit(slot int) doors.Attr {
	return doors.AClick{
		On: func(ctx context.Context, r doors.RequestEvent[doors.PointerEvent]) bool {
			f.r.Update(ctx, slot, "hit")
			return false
		},
	}
}

elem (f *emitterMultiFragment) Main() {
	~~
	f.r.Update(ctx, 0, "")
	f.r.Update(ctx, 1, "")
	f.r.Update(ctx, 2, "")
	~~
	~(f.r)
	<div id="m1" (&f.e) (doors.A(ctx, f.hit(1)))>m1</div>
	<div id="m2" (&f.e) (doors.A(ctx, f.hit(2)))>m2</div>
	~(test.Button("emit-count", emitterReport(f.r, 0, f.e.Click(doors.PointerEmit{}))))
}

// several emitters per element

type emitterSharedFragment struct {
	test.NoBeam
	r *test.Reporter
	a doors.Emitter
	b doors.Emitter
	c doors.Emitter
	s doors.Setter
}

func (f *emitterSharedFragment) hit(slot int) doors.Attr {
	return doors.AClick{
		On: func(ctx context.Context, r doors.RequestEvent[doors.PointerEvent]) bool {
			f.r.Update(ctx, slot, fmt.Sprint(r.Event().Button))
			return false
		},
	}
}

elem (f *emitterSharedFragment) Main() {
	~~
	for i := 0; i < 7; i++ {
		f.r.Update(ctx, i, "")
	}
	~~
	~(f.r)
	<div id="s1" (&f.a) (&f.b) (&f.s) (doors.A(ctx, f.hit(3)))>s1</div>
	<div id="s2" (&f.b) (doors.A(ctx, f.hit(4)))>s2</div>
	<div id="s3" (&f.c) (&f.c) (doors.A(ctx, f.hit(5)))>s3</div>
	~(test.Button("emit-a", emitterReport(f.r, 0, f.a.Click(doors.PointerEmit{Button: 1}))))
	~(test.Button("emit-b", emitterReport(f.r, 1, f.b.Click(doors.PointerEmit{Button: 2}))))
	~(test.Button("emit-c", emitterReport(f.r, 2, f.c.Click(doors.PointerEmit{Button: 3}))))
	~(test.Button("set", emitterCount(f.r, 6, f.s.Set("data-test", "x"))))
}

// emitter on a door container element

type emitterContainerFragment struct {
	test.NoBeam
	r *test.Reporter
	d doors.Door
	e doors.Emitter
}

func (f *emitterContainerFragment) hit(slot int) doors.Attr {
	return doors.AClick{
		On: func(ctx context.Context, r doors.RequestEvent[doors.PointerEvent]) bool {
			f.r.Update(ctx, slot, fmt.Sprint(r.Event().Button))
			return false
		},
	}
}

elem (f *emitterContainerFragment) body(text string) {
	<span id="c2">~(text)</span>
}

elem (f *emitterContainerFragment) Main() {
	~~
	f.r.Update(ctx, 0, "")
	f.r.Update(ctx, 1, "")
	~~
	~(f.r)
	<div id="c0" (doors.A(ctx, f.hit(1)))>
		~>(f.d) <div id="c1" (doors.A(ctx, &f.e))>
			~(f.body("first"))
		</div>
	</div>
	~(test.Button("emit", emitterReport(f.r, 0, f.e.Click(doors.PointerEmit{Button: 1}))))
	~(test.Button("emit2", emitterReport(f.r, 0, f.e.Click(doors.PointerEmit{Button: 2}))))
	~(test.Button("inner", func(ctx context.Context) bool {
		f.d.Inner(ctx, f.body("second"))
		return false
	}))
}

// click on a submit button triggers form submit

type emitterDerivedFragment struct {
	test.NoBeam
	r *test.Reporter
	e doors.Emitter
	done atomic.Int32
}

elem (f *emitterDerivedFragment) Main() {
	~~
	f.r.Update(ctx, 0, "")
	f.r.Update(ctx, 1, "")
	~~
	~(f.r)
	~>doors.ASubmit[struct{}]{
		On: func(ctx context.Context, r doors.RequestForm[struct{}]) bool {
			time.Sleep(200 * time.Millisecond)
			f.done.Add(1)
			return false
		},
	} <form>
		<input type="text" name="field"/>
		<button id="target" (&f.e)>go</button>
	</form>
	~(test.Button("emit", emitterCall(f.e.Click(doors.PointerEmit{}), func(ctx context.Context, report doors.EmitReport, err error) {
		f.r.Update(ctx, 0, emitReportString(report, err))
		f.r.Update(ctx, 1, fmt.Sprint(f.done.Load()))
	})))
}

// canceled and failed hooks are reported, the call waits for the rest

type emitterOutcomeFragment struct {
	test.NoBeam
	r *test.Reporter
	e doors.Emitter
	done atomic.Int32
}

elem (f *emitterOutcomeFragment) Main() {
	~~
	f.r.Update(ctx, 0, "")
	f.r.Update(ctx, 1, "")
	~~
	~(f.r)
	~>doors.AClick{
		ExactTarget: true,
		On: func(ctx context.Context, r doors.RequestEvent[doors.PointerEvent]) bool {
			f.done.Add(1)
			return false
		},
	} <div>
		~>doors.ASubmit[sysEmitForm]{
			On: func(ctx context.Context, r doors.RequestForm[sysEmitForm]) bool {
				f.done.Add(1)
				return false
			},
		} <form>
			<input type="text" name="n" value="x"/>
			~>doors.AClick{
				On: func(ctx context.Context, r doors.RequestEvent[doors.PointerEvent]) bool {
					time.Sleep(300 * time.Millisecond)
					f.done.Add(1)
					return false
				},
			} <button id="target" (&f.e)>go</button>
		</form>
	</div>
	~(test.Button("emit", emitterCall(f.e.Click(doors.PointerEmit{}), func(ctx context.Context, report doors.EmitReport, err error) {
		f.r.Update(ctx, 0, emitReportString(report, err))
		f.r.Update(ctx, 1, fmt.Sprint(f.done.Load()))
	})))
}

// emitter without attached elements fails, one without hooks reports zeros

type emitterDetachedFragment struct {
	test.NoBeam
	r *test.Reporter
	e doors.Emitter
	p doors.Emitter
}

elem (f *emitterDetachedFragment) Main() {
	~~
	f.r.Update(ctx, 0, "")
	f.r.Update(ctx, 1, "")
	~~
	~(f.r)
	<div id="plain" (&f.p)>plain</div>
	~(test.Button("emit", emitterReport(f.r, 0, f.e.Click(doors.PointerEmit{}))))
	~(test.Button("emit-plain", emitterReport(f.r, 1, f.p.Click(doors.PointerEmit{}))))
}

// emit to a disabled element fails without dispatching

type emitterDisabledFragment struct {
	test.NoBeam
	r *test.Reporter
	e doors.Emitter
	disabled bool
}

func (f *emitterDisabledFragment) hit(slot int) doors.Attr {
	return doors.AClick{
		On: func(ctx context.Context, r doors.RequestEvent[doors.PointerEvent]) bool {
			f.r.Update(ctx, slot, "hit")
			return false
		},
	}
}

elem (f *emitterDisabledFragment) Main() {
	~~
	for i := 0; i < 4; i++ {
		f.r.Update(ctx, i, "")
	}
	~~
	~(f.r)
	<button id="d1" (&f.e) (doors.A(ctx, f.hit(1)))>d1</button>
	<button id="d2" disabled=(f.disabled) (&f.e) (doors.A(ctx, f.hit(2)))>d2</button>
	~(test.Button("emit", emitterCall(f.e.Click(doors.PointerEmit{}), func(ctx context.Context, report doors.EmitReport, err error) {
		f.r.Update(ctx, 0, emitReportString(report, err))
		f.r.Update(ctx, 3, fmt.Sprint(errors.Is(err, doors.ErrExecution)))
	})))
}
