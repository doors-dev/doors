package attr

import (
	"context"
	"net/http"
	"slices"
	"sync"
	"sync/atomic"
	"time"

	"github.com/doors-dev/doors"
	"github.com/doors-dev/doors/internal/test"
	"github.com/doors-dev/gox"
)

type checkpointLog struct {
	mu      sync.Mutex
	entries []string
}

func (l *checkpointLog) add(entry string) {
	l.mu.Lock()
	defer l.mu.Unlock()
	l.entries = append(l.entries, entry)
}

func (l *checkpointLog) snapshot() []string {
	l.mu.Lock()
	defer l.mu.Unlock()
	return slices.Clone(l.entries)
}

type checkpointFragment struct {
	log   *checkpointLog
	value atomic.Value
	test.NoBeam
}

elem (f *checkpointFragment) Main() {
	~~
	cp := &doors.ScopeCheckpoint{}
	blocking := &doors.ScopeBlocking{}
	debounce := &doors.ScopeDebounce{Duration: 300 * time.Millisecond}
	latest := &doors.ScopeLatest{}
	fieldDebounce := &doors.ScopeDebounce{Duration: 300 * time.Millisecond}
	~~
	~(f.button("o1", cp.Scope(false), 600*time.Millisecond))
	~(f.button("o2", cp.Scope(false), 900*time.Millisecond))
	~(f.button("of", cp.Scope(false), 0))
	~(f.button("c1", cp.Scope(true), 400*time.Millisecond))
	~(f.button("c2", cp.Scope(true), 0))
	~(f.button("c3", cp.Scope(true), 0))
	~(f.button("cb", blocking.And(cp.Scope(true)), 400*time.Millisecond))
	~(f.button("od", cp.Scope(false).And(debounce), 300*time.Millisecond))
	~(f.button("cl", latest.And(cp.Scope(true)), 0))
	<button id="os" (doors.A(ctx, doors.AClick{
		Scope: cp.Scope(false),
		Race:  doors.RaceParallel,
		On: func(ctx context.Context, r doors.RequestEvent[doors.PointerEvent]) bool {
			f.log.add("start:os")
			<-time.After(300 * time.Millisecond)
			f.log.add("end:os")
			return false
		},
	}))>os</button>
	<input id="field" (doors.A(ctx, doors.AInput{
		Scope: cp.Scope(false).And(fieldDebounce),
		On: func(ctx context.Context, r doors.RequestEvent[doors.InputEvent]) bool {
			<-time.After(100 * time.Millisecond)
			f.value.Store(r.Event().Value)
			f.log.add("field:" + r.Event().Value)
			return false
		},
	}))/>
	<button id="sub" (doors.A(ctx, doors.AClick{
		Scope: cp.Scope(true),
		On: func(ctx context.Context, r doors.RequestEvent[doors.PointerEvent]) bool {
			value, _ := f.value.Load().(string)
			f.log.add("submit:" + value)
			return false
		},
	}))>sub</button>
	<button id="he">he</button>
	<button id="ht">ht</button>
	~>doors.ARawHook{
		Name:  "he",
		Scope: cp.Scope(false),
		On: func(ctx context.Context, r doors.RequestRawHook) bool {
			f.log.add("start:he")
			<-time.After(400 * time.Millisecond)
			f.log.add("fail:he")
			r.ResponseWriter().WriteHeader(http.StatusConflict)
			return false
		},
	} ~>doors.ARawHook{
		Name:           "ht",
		Scope:          cp.Scope(false),
		RequestTimeout: 300 * time.Millisecond,
		On: func(ctx context.Context, r doors.RequestRawHook) bool {
			f.log.add("start:ht")
			<-time.After(800 * time.Millisecond)
			f.log.add("end:ht")
			return false
		},
	} <script>
		for (const name of ["he", "ht"]) {
			document.getElementById(name).addEventListener("click", () => {
				$hook(name).catch(() => {})
			})
		}
	</script>
}

elem (f *checkpointFragment) button(id string, scope doors.Scopes, delay time.Duration) {
	<button id=(id) (doors.A(ctx, f.handler(id, scope, delay)))>~(id)</button>
}

func (f *checkpointFragment) handler(id string, scope doors.Scopes, delay time.Duration) doors.Attr {
	return doors.AClick{
		Scope: scope,
		On: func(ctx context.Context, r doors.RequestEvent[doors.PointerEvent]) bool {
			f.log.add("start:" + id)
			<-time.After(delay)
			f.log.add("end:" + id)
			return false
		},
	}
}
