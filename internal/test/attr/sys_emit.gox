package attr

import (
	"context"
	"fmt"
	"sync/atomic"
	"time"

	"github.com/doors-dev/doors"
	"github.com/doors-dev/doors/internal/test"
	"github.com/doors-dev/gox"
)

type sysEmitResult struct {
	OK       int      `json:"ok"`
	Canceled int      `json:"canceled"`
	Failed   []string `json:"failed"`
	Error    string   `json:"error"`
}

func sysEmitHook(r *test.Reporter, slot int, done *atomic.Int32) doors.AHook[sysEmitResult] {
	return doors.AHook[sysEmitResult]{
		Name: "report",
		On: func(ctx context.Context, h doors.RequestHook[sysEmitResult]) (any, bool) {
			res := h.Data()
			if res.Error != "" {
				r.Update(ctx, slot, res.Error)
			} else {
				r.Update(ctx, slot, fmt.Sprintf("ok:%d canceled:%d failed:%v", res.OK, res.Canceled, res.Failed))
			}
			r.Update(ctx, slot+1, fmt.Sprint(done.Load()))
			return nil, true
		},
	}
}

type sysEmitFragment struct {
	test.NoBeam
	r *test.Reporter
	done atomic.Int32
}

func (f *sysEmitFragment) hit(slot int) doors.Attr {
	return doors.AClick{
		On: func(ctx context.Context, r doors.RequestEvent[doors.PointerEvent]) bool {
			time.Sleep(200 * time.Millisecond)
			f.done.Add(1)
			f.r.Update(ctx, slot, fmt.Sprint(r.Event().Button))
			return false
		},
	}
}

elem (f *sysEmitFragment) Main() {
	~~
	for i := 0; i < 4; i++ {
		f.r.Update(ctx, i, "")
	}
	~~
	~(f.r)
	<div id="outer" (doors.A(ctx, f.hit(0)))>
		<div id="inner" (doors.A(ctx, f.hit(1)))>target</div>
	</div>
	~>(sysEmitHook(f.r, 2, &f.done)) <script>
		const r = await $sys.emit(
			document.getElementById("inner"),
			new PointerEvent("click", { bubbles: true, button: 2 }),
		)
		await $hook("report", { ...r, failed: r.failed.map((e) => e.kind + ": " + e.message) })
	</script>
}

type sysEmitForm struct {
	N int `form:"n"`
}

type sysEmitSubmitFragment struct {
	test.NoBeam
	r *test.Reporter
	click bool
	fail bool
	block bool
	done atomic.Int32
}

func (f *sysEmitSubmitFragment) scope() doors.Scopes {
	if !f.block {
		return nil
	}
	return &doors.ScopeBlocking{}
}

func (f *sysEmitSubmitFragment) attrs(scope doors.Scopes) []doors.Attr {
	if !f.click {
		return nil
	}
	return []doors.Attr{doors.AClick{
		Scope: scope,
		On: func(ctx context.Context, r doors.RequestEvent[doors.PointerEvent]) bool {
			time.Sleep(300 * time.Millisecond)
			f.done.Add(1)
			return false
		},
	}}
}

func (f *sysEmitSubmitFragment) value() string {
	if f.fail {
		return "x"
	}
	return "1"
}

elem (f *sysEmitSubmitFragment) Main() {
	~~
	for i := 0; i < 2; i++ {
		f.r.Update(ctx, i, "")
	}
	scope := f.scope()
	~~
	~(f.r)
	~>doors.ASubmit[sysEmitForm]{
		Scope: scope,
		On: func(ctx context.Context, r doors.RequestForm[sysEmitForm]) bool {
			time.Sleep(200 * time.Millisecond)
			f.done.Add(1)
			return false
		},
	} <form>
		<input type="text" name="n" value=(f.value())/>
		<button id="target" (doors.A(ctx, f.attrs(scope)...))>go</button>
	</form>
	~>(sysEmitHook(f.r, 0, &f.done)) <script>
		let res
		try {
			const r = await $sys.emit(
				document.getElementById("target"),
				new MouseEvent("click", { bubbles: true, cancelable: true }),
			)
			res = { ...r, failed: r.failed.map((e) => e.kind + ": " + e.message) }
		} catch (e) {
			res = { error: e.kind + ": " + e.message }
		}
		await $hook("report", res)
	</script>
}

type sysEmitLabelFragment struct {
	test.NoBeam
	r *test.Reporter
	done atomic.Int32
}

elem (f *sysEmitLabelFragment) Main() {
	~~
	f.r.Update(ctx, 0, "")
	f.r.Update(ctx, 1, "")
	~~
	~(f.r)
	~>doors.AClick{
		ExactTarget: true,
		On: func(ctx context.Context, r doors.RequestEvent[doors.PointerEvent]) bool {
			f.done.Add(1)
			return false
		},
	} <label id="label">
		<input type="checkbox" id="box"/>
		box
	</label>
	~>(sysEmitHook(f.r, 0, &f.done)) <script>
		let res
		try {
			const r = await $sys.emit(
				document.getElementById("label"),
				new PointerEvent("click", { bubbles: true, cancelable: true }),
			)
			res = { ...r, failed: r.failed.map((e) => e.kind + ": " + e.message) }
		} catch (e) {
			res = { error: e.kind + ": " + e.message }
		}
		await $hook("report", res)
	</script>
}

type sysEmitUnrelatedFragment struct {
	test.NoBeam
	r *test.Reporter
	done atomic.Int32
}

func (f *sysEmitUnrelatedFragment) hit(slot int, delay time.Duration) doors.Attr {
	return doors.AClick{
		On: func(ctx context.Context, r doors.RequestEvent[doors.PointerEvent]) bool {
			time.Sleep(delay)
			f.done.Add(1)
			f.r.Update(ctx, slot, "hit")
			return false
		},
	}
}

elem (f *sysEmitUnrelatedFragment) Main() {
	~~
	for i := 0; i < 4; i++ {
		f.r.Update(ctx, i, "")
	}
	~~
	~(f.r)
	<div id="target" (doors.A(ctx, f.hit(0, 300*time.Millisecond)))>target</div>
	<div id="other" (doors.A(ctx, f.hit(1, 0)))>other</div>
	~>(sysEmitHook(f.r, 2, &f.done)) <script>
		const other = document.getElementById("other")
		const p = $sys.emit(
			document.getElementById("target"),
			new PointerEvent("click", { bubbles: true }),
		)
		other.dispatchEvent(new PointerEvent("click", { bubbles: true }))
		setTimeout(() => other.dispatchEvent(new PointerEvent("click", { bubbles: true })), 50)
		const r = await p
		await $hook("report", { ...r, failed: r.failed.map((e) => e.kind + ": " + e.message) })
	</script>
}

type sysEmitTargetFragment struct {
	test.NoBeam
	r *test.Reporter
	mode string
	done atomic.Int32
}

func (f *sysEmitTargetFragment) inert() bool {
	return f.mode == "inert" || f.mode == "shadow" || f.mode == "text"
}

elem (f *sysEmitTargetFragment) Main() {
	~~
	for i := 0; i < 3; i++ {
		f.r.Update(ctx, i, "")
	}
	~~
	~(f.r)
	<div inert=(f.inert())>
		<fieldset disabled=(f.mode == "fieldset")>
			~>doors.AClick{
				On: func(ctx context.Context, r doors.RequestEvent[doors.PointerEvent]) bool {
					f.done.Add(1)
					f.r.Update(ctx, 0, "hit")
					return false
				},
			} <button id="target" disabled=(f.mode == "disabled")>go</button>
		</fieldset>
		<div id="host"></div>
		<div id="plain">plain</div>
	</div>
	~>(sysEmitHook(f.r, 1, &f.done)) <script data:mode=(f.mode)>
		const mode = await $data("mode")
		let target = document.getElementById("target")
		if (mode == "shadow") {
			target = document.createElement("button")
			document.getElementById("host").attachShadow({ mode: "open" }).appendChild(target)
		} else if (mode == "text") {
			target = target.firstChild
		} else if (mode == "none") {
			target = document.getElementById("plain")
		}
		let res
		try {
			const r = await $sys.emit(target, new PointerEvent("click", { bubbles: true }))
			res = { ...r, failed: r.failed.map((e) => e.kind + ": " + e.message) }
		} catch (e) {
			res = { error: e.kind + ": " + e.message }
		}
		await $hook("report", res)
	</script>
}
