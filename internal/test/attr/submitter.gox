package attr

import (
	"context"
	"fmt"
	"sync/atomic"
	"time"

	"github.com/doors-dev/doors"
	"github.com/doors-dev/doors/internal/test"
	"github.com/doors-dev/gox"
)

type submitterFragment struct {
	test.NoBeam
	r     *test.Reporter
	count atomic.Int32
}

type submitterData struct {
	Title  string `form:"title"`
	Intent string `form:"intent"`
}

elem (f *submitterFragment) Main() {
	~(f.r)
	~>doors.ASubmit[submitterData]{
		Indicator: doors.IndicateAttrSubmitter("data-busy", "yes"),
		On: func(ctx context.Context, r doors.RequestForm[submitterData]) bool {
			<-time.After(400 * time.Millisecond)
			intent := r.Data().Intent
			if intent == "" {
				intent = "none"
			}
			f.r.Update(ctx, 0, intent)
			f.r.Update(ctx, 1, fmt.Sprint(f.count.Add(1)))
			return false
		},
	} <form id="sform">
		<input type="text" id="title" name="title"/>
		<button id="draft" name="intent" value="draft">Draft</button>
		<button id="publish" name="intent" value="publish">Publish</button>
	</form>
}
