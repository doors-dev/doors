		})>
		<span id="container-inner-value">initial</span>
	</div>
}

type FragmentContainerEffectLifecycle struct {
	node doors.Door
	source doors.Source[int]
	test.NoBeam
}

func (f *FragmentContainerEffectLifecycle) init() {
	if f.source == nil {
		f.source = doors.NewSource(0)
	}
}

elem (f *FragmentContainerEffectLifecycle) content(label string) {
	<span id="container-effect-value">~(fmt.Sprintf("%s-%d", label, f.source.Get()))</span>
}

elem (f *FragmentContainerEffectLifecycle) Main() {
	~~
	f.init()
	~~
	~>(f.node) <div
		id="container-effect-root"
		(containerEffectAttr{source: f.source})>
		~(f.content("initial"))
	</div>
	~(test.Button("container-effect-inner", func(ctx context.Context) bool {
		f.node.Inner(ctx, f.content("inner"))
		return false
	}))
	~(test.Button("container-effect-update", func(ctx context.Context) bool {
		f.source.Update(ctx, f.source.Get() + 1)
		return false
	}))
}

