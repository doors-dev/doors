	})
}

type FragmentX struct {
	report doors.Door
	n doors.Door
	test.NoBeam
}

func (f *FragmentX) rep(ctx context.Context, s string) {
	f.report.Inner(ctx, test.Report(s))
}

elem (f *FragmentX) Main() {
	~>(f.n) <>
		~(test.Marker("init"))
	</>
	~>(f.report) ~>doors.AClick{
		On: func(ctx context.Context, _ doors.RequestEvent[doors.PointerEvent]) bool {
			ch := f.n.Inner(ctx, test.Marker("updated"))
			count := 0
			for err := range ch {
				count++
				if err != nil {
					f.rep(ctx, "channel err: " + err.Error())
					return false
				}
			}
			if count == 0 {
				f.rep(ctx, "channel closed")
				return false
			}
			f.rep(ctx, "ok upd")
			return false
		},
	} <button id="updatex">C</button>
	
	~>doors.AClick{
		On: func(ctx context.Context, _ doors.RequestEvent[doors.PointerEvent]) bool {
			ch := f.n.Static(ctx, nil)
			count := 0
			for err := range ch {
				count++
				if err != nil {
					f.rep(ctx, "channel err: " + err.Error())
					return false
				}
			}
			if count == 0 {
				f.rep(ctx, "channel closed")
				return false
			}
			f.rep(ctx, "ok del")
			return false
		},
	} <button id="removex">R</button>
}

type FragmentXDoor struct {
	report doors.Door
	frame doors.Door
	n doors.Door
	test.NoBeam
}

func (f *FragmentXDoor) rep(ctx context.Context, s string) {
	f.report.Inner(ctx, test.Report(s))
}

func (f *FragmentXDoor) wait(ctx context.Context, ch <-chan error, okMsg string) bool {
	count := 0
	for err := range ch {
		count++
		if err != nil {
			f.rep(ctx, "channel err: " + err.Error())
			return false
		}
	}
	if count == 0 {
		f.rep(ctx, "channel closed")
		return false
	}
	f.rep(ctx, okMsg)
	return false
}

elem (f *FragmentXDoor) mount() {
	~(&f.n)
}

elem (f *FragmentXDoor) Main() {
	~~
	f.n.Inner(ctx, test.Marker("x-init"))
	f.frame.Inner(ctx, f.mount())
	~~
	~(&f.frame)
	~(&f.report)
	~>doors.AClick{
		On: func(ctx context.Context, _ doors.RequestEvent[doors.PointerEvent]) bool {
			return f.wait(ctx, f.n.Reload(ctx), "ok reload")
		},
	} <button id="xreload">xreload</button>
	~>doors.AClick{
		On: func(ctx context.Context, _ doors.RequestEvent[doors.PointerEvent]) bool {
			return f.wait(ctx, f.n.Outer(ctx, <section id="x-rebased-root">
				~(test.Marker("x-rebased"))
			</section>), "ok rebase")
		},
	} <button id="xrebase">xrebase</button>
	~>doors.AClick{
		On: func(ctx context.Context, _ doors.RequestEvent[doors.PointerEvent]) bool {
			return f.wait(ctx, f.n.Inner(ctx, nil), "ok clear")
		},
	} <button id="xclear">xclear</button>
	~>doors.AClick{
		On: func(ctx context.Context, _ doors.RequestEvent[doors.PointerEvent]) bool {
			return f.wait(ctx, f.n.Inner(ctx, test.Marker("x-updated")), "ok update")
		},
	} <button id="xupdate">xupdate</button>
	~>doors.AClick{
		On: func(ctx context.Context, _ doors.RequestEvent[doors.PointerEvent]) bool {
			return f.wait(ctx, f.n.Unmount(ctx), "ok unmount")
		},
	} <button id="xunmount">xunmount</button>
	~(test.Button("xremount", func(ctx context.Context) bool {
		f.frame.Inner(ctx, f.mount())
		return false
	}))
	~>doors.AClick{
		On: func(ctx context.Context, _ doors.RequestEvent[doors.PointerEvent]) bool {
			return f.wait(ctx, f.n.Static(ctx, test.Marker("x-replaced")), "ok replace")
		},
	} <button id="xreplace">xreplace</button>
}

type EmbeddedFragment struct {
	n1 doors.Door
	n2 doors.Door
	n3 doors.Door
	test.NoBeam
}

elem (f *EmbeddedFragment) Main() {
	~>(f.n1) <>
		~>(f.n2) <div>
			~(test.Marker("init"))
		</div>
		~(test.Marker("static"))
	</>
	~(&f.n3)
	<button
		id="remove"
		(doors.AClick{
			On: func(ctx context.Context, _ doors.RequestEvent[doors.PointerEvent]) bool {
				f.n2.Static(ctx, nil)
				return true
			},
		})>
		C
	</button>
	<button
		id="clear"
		(doors.AClick{
			On: func(ctx context.Context, _ doors.RequestEvent[doors.PointerEvent]) bool {
				f.n1.Inner(ctx, nil)
				return true
			},
		})>
		C
	</button>
	<button
		id="replace"
		(doors.AClick{
			On: func(ctx context.Context, _ doors.RequestEvent[doors.PointerEvent]) bool {
				f.n2.Inner(ctx, test.Marker("replaced"))
				f.n3.Inner(ctx, test.Marker("temp"))
				f.n3.Static(ctx, &f.n2)
				return true
			},
		})>
		C
	</button>
}

