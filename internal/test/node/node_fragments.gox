type LifeCycleFragment struct {
	frame doors.Door
	node doors.Door
	test.NoBeam
}

elem (f *LifeCycleFragment) Main() {
	~>(f.frame) ~(f.initial())
	<button
		id="reload"
		(doors.AClick{
			On: func(ctx context.Context, _ doors.RequestEvent[doors.PointerEvent]) bool {
				f.node.Reload(ctx)
				return false
			},
		})>
		Reload
	</button>
	<button
		id="updateEmpty"
		(doors.AClick{
			On: func(ctx context.Context, _ doors.RequestEvent[doors.PointerEvent]) bool {
				f.frame.Inner(ctx, f.newEmpty())
				return false
			},
		})>
		Update1
	</button>
	<button
		id="updateEmptyAlt"
		(doors.AClick{
			On: func(ctx context.Context, _ doors.RequestEvent[doors.PointerEvent]) bool {
				f.frame.Inner(ctx, f.newEmptyAlt())
				return false
			},
		})>
		Update1Alt
	</button>
	<button
		id="updateContent"
		(doors.AClick{
			On: func(ctx context.Context, _ doors.RequestEvent[doors.PointerEvent]) bool {
				f.frame.Inner(ctx, f.newContent())
				return false
			},
		})>
		Update2
	</button>
	<button
		id="updateInner"
		(doors.AClick{
			On: func(ctx context.Context, _ doors.RequestEvent[doors.PointerEvent]) bool {
				f.node.Inner(ctx, test.Marker("inner-maintained"))
				return false
			},
		})>
		UpdateInner
	</button>
	<button
		id="updateOuter"
		(doors.AClick{
			On: func(ctx context.Context, _ doors.RequestEvent[doors.PointerEvent]) bool {
				f.node.Outer(ctx, f.newOuter())
				return false
			},
		})>
		UpdateOuter
	</button>
	<button
		id="replaceStatic"
		(doors.AClick{
			On: func(ctx context.Context, _ doors.RequestEvent[doors.PointerEvent]) bool {
				f.node.Static(ctx, test.Marker("static-presist"))
				return false
			},
		})>
		ReplaceStatic
	</button>
	<button
		id="updateEditor"
		(doors.AClick{
			On: func(ctx context.Context, _ doors.RequestEvent[doors.PointerEvent]) bool {
				f.frame.Inner(ctx, f.newEditor())
				return false
			},
		})>
		Update2
	</button>
	<button
		id="clear"
		(doors.AClick{
			On: func(ctx context.Context, _ doors.RequestEvent[doors.PointerEvent]) bool {
				f.node.Inner(ctx, nil)
				return false
			},
		})>
		Clear
	</button>
	<button
		id="unmount"
		(doors.AClick{
			On: func(ctx context.Context, _ doors.RequestEvent[doors.PointerEvent]) bool {
				f.node.Unmount(ctx)
				return false
			},
		})>
		Unmount
	</button>
	<button
		id="remove"
		(doors.AClick{
			On: func(ctx context.Context, _ doors.RequestEvent[doors.PointerEvent]) bool {
				f.node.Static(ctx, nil)
				return false
			},
		})>
		Remove
	</button>
}

