type FragmentClosestTrackedReload struct {
	frame doors.Door
	node doors.Door
	report doors.Door
	outerRenders int
	innerRenders int
	test.NoBeam
}

func (f *FragmentClosestTrackedReload) rep(ctx context.Context, s string) {
	f.report.Inner(ctx, test.Report(s))
}

func (f *FragmentClosestTrackedReload) wait(ctx context.Context, ch <-chan error, okMsg string) bool {
	count := 0
	for err := range ch {
		count++
		if err != nil {
			f.rep(ctx, "channel err: " + err.Error())
			return false
		}
	}
	if count == 0 {
		f.rep(ctx, "channel closed")
		return false
	}
	f.rep(ctx, okMsg)
	return false
}

elem (f *FragmentClosestTrackedReload) innerContent() {
	~~
	f.innerRenders++
	~~
	<div id="x-inner-count">~(fmt.Sprintf("inner-%d", f.innerRenders))</div>
	<button
		id="xreload-nearest"
		(doors.AClick{
			On: func(ctx context.Context, _ doors.RequestEvent[doors.PointerEvent]) bool {
				return f.wait(ctx, doors.Reload(ctx), "ok xreload")
			},
		})>
		xreload-nearest
	</button>
}

elem (f *FragmentClosestTrackedReload) outerContent() {
	~~
	f.outerRenders++
	f.node.Inner(ctx, f.innerContent())
	~~
	<div id="x-outer-count">~(fmt.Sprintf("outer-%d", f.outerRenders))</div>
	~(&f.node)
}

elem (f *FragmentClosestTrackedReload) Main() {
	~~
	f.frame.Inner(ctx, f.outerContent())
	~~
	~(&f.frame)
	~(&f.report)
}

